<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- plaid_prefs can transiently hold a legacy Plaid access token until
         PlaidManager's one-time /plaid/migrate migration clears it (see
         DashboardViewModel.migrateLegacyPlaidDataIfNeeded). Auto Backup can
         run before that migration completes, so exclude it outright rather
         than relying on timing to keep a credential out of backups. -->
    <exclude domain="sharedpref" path="plaid_prefs.xml"/>
</full-backup-content>