<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- plaid_prefs can transiently hold a legacy Plaid access token
             until the one-time /plaid/migrate migration clears it - see
             backup_rules.xml for the full rationale. -->
        <exclude domain="sharedpref" path="plaid_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="plaid_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>